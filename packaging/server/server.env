# Mount Manager server configuration (mode 0640 root:mmserver - contains the DB password)
MM_DSN=postgres://mountmgr:CHANGEME@dbhost:5432/mountmgr
# Comma-separated DNS names / IPs that agents and admins use to reach this server (server certificate SANs)
MM_NAMES=localhost
MM_AGENT_LISTEN=:8443
MM_ADMIN_LISTEN=:8444
# Certificates from your own CA (PEM chain + unencrypted PEM key, readable by the mmserver group). When unset, the
# built-in CA's certificate is used. Reloaded automatically when the files change (renewals need no restart).
#MM_TLS_CERT=/etc/mountmgr-server/tls/server.crt      # both listeners, unless overridden below
#MM_TLS_KEY=/etc/mountmgr-server/tls/server.key
#MM_ADMIN_TLS_CERT=  #MM_ADMIN_TLS_KEY=               # web UI / API listener only
#MM_AGENT_TLS_CERT=  #MM_AGENT_TLS_KEY=               # agent listener only (agents then need server_ca_file, see agent.conf)
# Directory (LDAPS / Active Directory) login. Copy ldap.json.example to ldap.json, edit, then uncomment.
# Validate first with:  mmserver -ldap-config /etc/mountmgr-server/ldap.json -ldap-check <username>
#MM_LDAP_CONFIG=/etc/mountmgr-server/ldap.json

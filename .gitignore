# Lab credentials and keys - never commit
nogit/

# Build output, binaries and packages
build/
*.rpm
*.o
/agent/mmd
/agent/tests/test_mount
/server/mmserver
/server/mmctl
/server/cmd/mmserver/mmserver
/server/cmd/mmctl/mmctl

# Web UI: dependencies and the built bundle (embedded into mmserver at build time).
# dist/.gitkeep is tracked so `go build` works on a fresh clone before the UI has been built.
node_modules/
/server/internal/ui/dist/*
!/server/internal/ui/dist/.gitkeep

# Local state and editor files
*.log
*.swp
.DS_Store
.idea/
.vscode/
